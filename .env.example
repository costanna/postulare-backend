# Copia este fichero como .env y rellena los valores reales.
# Nunca subas el .env real al repositorio.

# Base de datos
# Local/Docker: la de abajo. En producción (Render) es un proyecto de
# Neon (https://neon.tech) - usa su cadena de conexión "directa", con
# ?sslmode=require. Ver "Despliegue en Render" en el README.
DATABASE_URL=postgresql+psycopg2://postulare:postulare@localhost:5432/postulare

# Seguridad / JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: dominios del frontend separados por coma
CORS_ORIGINS=http://localhost:4200

# API de ofertas de empleo (Adzuna) - https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=es

# InfoJobs (opcional): segunda fuente de ofertas. Registra una aplicación en
# https://developer.infojobs.net (necesitas una cuenta de InfoJobs) para obtener las dos claves.
# Sin ellas, solo se busca en Adzuna.
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
# Tope diario GLOBAL de llamadas reales a InfoJobs. 0 = sin tope
INFOJOBS_DAILY_LIMIT=50

# Fuentes gratuitas sin clave (Remotive, RemoteOK, Arbeitnow): solo remoto/Europa.
# Se usan cuando el filtro es remoto/híbrido o no hay ubicación. Gratis siempre.
FREE_BOARDS_ENABLED=true
FREE_BOARDS_MAX_RESULTS=20

# EURES (portal europeo de empleo, filtro España, incluye Empléate/SEPE):
# gratis, sin clave. Se usa cuando la ubicación es España o no hay ubicación.
EURES_ENABLED=true
EURES_MAX_RESULTS=20

# Hilo mensual "Ask HN: Who is hiring?": empresas con email público,
# filtradas por España/remoto. Gratis, sin clave.
HN_HIRING_ENABLED=true

# Cartas de presentación con IA (Claude). OPCIONAL: sin clave se usa una plantilla gratuita.
# Cada carta con IA cuesta dinero (céntimos con claude-opus-5): los topes de abajo acotan el gasto.
ANTHROPIC_API_KEY=
# Modelo. claude-opus-5 = mejor calidad; claude-haiku-4-5 = bastante más barato
ANTHROPIC_MODEL=claude-opus-5
# Tope GLOBAL de cartas con IA por día (todos los usuarios juntos) y por usuario. 0 = sin tope
LLM_DAILY_LIMIT=20
COVER_LETTER_DAILY_LIMIT_PER_USER=5

# Cuentas demo temporales ("Prueba la demo": datos de ejemplo, sin búsqueda real ni IA)
DEMO_ENABLED=true
DEMO_TTL_HOURS=24
DEMO_ACCOUNTS_DAILY_LIMIT=200
DEMO_LIMIT_PER_HOUR=5

# Registro restringido: si tiene emails (separados por coma), solo ellos
# pueden registrarse. Vacío = registro abierto.
# Para uso personal: ALLOWED_REGISTRATION_EMAILS=costanna.bcn@gmail.com
ALLOWED_REGISTRATION_EMAILS=

# Días sin novedades tras aplicar a partir de los cuales toca hacer seguimiento
FOLLOW_UP_DAYS=7

# Importar CV (PDF): solo se lee en memoria, nunca se guarda
CV_MAX_BYTES=2000000
CV_MAX_PAGES=6
CV_IMPORT_LIMIT_PER_HOUR=15

# Rate limiting de "Buscar ofertas"
MATCH_SEARCH_COOLDOWN_MINUTES=10
# Tope GLOBAL de llamadas reales a Adzuna por día (todos los usuarios juntos);
# 0 = sin tope. Protege tu cuota gratuita si la demo es pública.
ADZUNA_DAILY_LIMIT=50
# Minutos que se reutiliza una búsqueda idéntica sin volver a llamar a Adzuna (0 = sin caché)
ADZUNA_CACHE_MINUTES=360
# Límites por IP en registro / login / recuperar contraseña
RATE_LIMIT_ENABLED=true
REGISTER_LIMIT_PER_HOUR=10
LOGIN_LIMIT_PER_MINUTE=20
FORGOT_PASSWORD_LIMIT_PER_HOUR=5

# Email (recuperación de contraseña). En desarrollo se puede dejar vacío:
# el enlace se imprime en los logs del backend en vez de enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@postulare.app

# Envío directo de candidaturas (POST /matches/{id}/send-email, solo cuentas
# reales). Con Gmail: activa la verificación en 2 pasos y crea una
# "contraseña de aplicación" en myaccount.google.com/apppasswords (NO tu
# contraseña normal). Luego:
# SMTP_HOST=smtp.gmail.com / SMTP_PORT=587
# SMTP_USER=tu@gmail.com / SMTP_PASSWORD=<la de 16 letras> / SMTP_FROM=tu@gmail.com
# Límite gratis de Gmail: ~500 envíos/día.
# Postulare además limita a 5/día a empresas distintas y margen entre
# reenvíos (15 días en ofertas, 30 en espontáneas).
SEND_EMAIL_DAILY_LIMIT_PER_USER=5
OFFER_RESEND_DAYS=15
SPONTANEOUS_RESEND_DAYS=30

FRONTEND_URL=http://localhost:4200
